# ==============================================================================
# JANMITRA React + Vite Frontend Environment Configuration Template
# Copy this file to `frontend/.env` and customize if deploying remotely.
# ==============================================================================

VITE_API_BASE_URL=http://localhost:8000
REACT_APP_API_BASE_URL=http://localhost:8000

# Optional Firebase Web Push (FCM) credentials
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_VAPID_KEY=your_firebase_web_push_vapid_key
