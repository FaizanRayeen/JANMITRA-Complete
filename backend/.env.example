# ==============================================================================
# JANMITRA Backend Environment Configuration Template
# Copy this file to `backend/.env` and replace placeholder values before running.
# ==============================================================================

# Generate a unique random key for production (e.g. python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=replace-with-a-long-random-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional PostgreSQL / PostGIS URL; defaults to local SQLite db.sqlite3 when unset
# DATABASE_URL=sqlite:///db.sqlite3

# Optional Firebase Admin SDK service account JSON path (NEVER commit the real JSON)
FIREBASE_CREDENTIALS_PATH=./config/firebase-service-account.json

# Optional Redis / Celery worker URLs (falls back to synchronous execution if offline)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS
CORS_ALLOW_ALL_ORIGINS=True
